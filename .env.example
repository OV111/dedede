# Copy to .env and change the secret. Never commit the real .env.
PORT=3000
# 16+ characters; used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_FILE=./data/notes.db
# bcrypt cost: 12 is a sensible default; tests use 4 for speed
BCRYPT_ROUNDS=12
# max register/login requests per IP per 15 minutes
AUTH_RATE_LIMIT=20
